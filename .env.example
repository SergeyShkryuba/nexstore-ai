# ---- Supabase (required) -------------------------------------------------
# Project URL and anon key: Supabase dashboard -> Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. Server-side only: used by the Stripe webhook to write
# orders while bypassing RLS, and as the HMAC key for rate-limit counters
# (without it, checkout and search are not rate-limited). Never expose this
# to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe (optional: checkout is disabled without it) ------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Shop assistant (optional: the chat widget is hidden without it) ------
# Claude API key: console.anthropic.com -> API keys. Server-side only. The
# widget is built into the pages, so redeploy after setting or removing it.
ANTHROPIC_API_KEY=

# ---- Owner alerts (optional: each messenger is skipped when unset) -------
# New orders (with anything running low) and "talk to a person" requests.
# Telegram: create a bot with @BotFather, press Start in it, then find your
# chat id with https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API
# setup). Businesses may only start a conversation with an approved template:
# create "store_alert" (Utility), body
#   NexStore AI: {{1}}. {{2}} Details in the admin panel.
# The owner number is digits only, with the country code.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_NUMBER=
# Optional overrides: WHATSAPP_ALERT_TEMPLATE (store_alert),
# WHATSAPP_TEMPLATE_LANGUAGE (en), WHATSAPP_API_VERSION (v26.0).

# ---- Site --------------------------------------------------------------
# Optional on Vercel: the production domain is picked up automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Keep-alive (optional, production) -----------------------------------
# Any long random string. Vercel Cron sends it to /api/keepalive, which pings
# the database daily so a free Supabase project is never paused.
CRON_SECRET=

# ---- Error monitoring (optional) -----------------------------------------
# A Sentry project's DSN (sentry.io -> Project settings -> Client Keys). Unset,
# the SDK is never loaded. It is public by design: browsers send reports to it.
# Also allowed by the Content Security Policy, which is built at build time,
# so redeploy after changing it.
NEXT_PUBLIC_SENTRY_DSN=
